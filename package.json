{
  "name": "kairo-trading",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "launch": "npm install && npm run lint && npm test -- --runInBand && npm run test:e2e && concurrently --kill-others --names mock,next \"npm run mock:ws\" \"npm run dev\"",
    "dev:ws": "concurrently --kill-others --names mock,next \"npm run mock:ws\" \"npm run dev\"",
    "dev": "next dev",
    "mock:ws": "tsx scripts/mock-quotes.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:visible": "playwright test --headed"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/numeral": "^2.0.5",
    "antd": "^6.6.7",
    "classnames": "^2.5.1",
    "next": "16.4.2",
    "numeral": "^2.0.6",
    "randex": "^1.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "^9.3.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "sass": "^1.106.0",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "ws": "^8.18.3"
  }
}
